# Sports Hedge Phase 1 — PAPER ONLY
# Canonical local dotenv: copy this file to `.env` at repository root.
# backend/.env is not read. Process environment variables override these values.
SPORTS_HEDGE_MODE=paper
SPORTS_HEDGE_EXECUTION_ENABLED=false

# Matchbook read-only integration
MATCHBOOK_USERNAME=
MATCHBOOK_PASSWORD=
MATCHBOOK_MFA_CODE=
MATCHBOOK_BASE_URL=https://api.matchbook.com
MATCHBOOK_CURRENCY=GBP
MATCHBOOK_PRICE_DEPTH=5
MATCHBOOK_MINIMUM_LIQUIDITY=2

# Polymarket public/read-only integration
POLYMARKET_GAMMA_BASE_URL=https://gamma-api.polymarket.com
POLYMARKET_CLOB_BASE_URL=https://clob.polymarket.com
# Public GET /sports series IDs (2026-09-16): EPL=10188, EFL Championship=10355,
# La Liga=10193, EFL CUP=10329, FA Cup=10307, FIFA Friendlies=10238,
# Bundesliga=10194, Serie A=10203. Comma-separated. Bounded pagination is per series.
POLYMARKET_GAMMA_SERIES_IDS=10188,10355,10193,10329,10307,10238,10194,10203
# Legacy single-series setting. If set (including to 10188), it is merged
# into POLYMARKET_GAMMA_SERIES_IDS rather than replacing it, so current
# target competitions stay queried. Empty value still disables series filtering.
# Leave unset. Prefer POLYMARKET_GAMMA_SERIES_IDS.
# POLYMARKET_GAMMA_SERIES_ID=

# Kalshi first-class venue (public Trade API v2 market data). Same Phase-1
# capability posture as Matchbook: data + paper enabled, execution disabled.
KALSHI_BASE_URL=https://external-api.kalshi.com/trade-api/v2
KALSHI_DEMO_BASE_URL=https://external-api.demo.kalshi.co/trade-api/v2
KALSHI_USE_DEMO=false
# Football-relevant series for target competitions (GAME/BTTS/TOTAL/FTTS).
# Empty list disables the allowlist and queries open events across series.
# International friendlies have no verified Kalshi FTTS series as of 2026-09-16.
KALSHI_SERIES_TICKERS=KXEPLGAME,KXEPLBTTS,KXEPLTOTAL,KXEPLFTTS,KXEFLCHAMPIONSHIPGAME,KXEFLCHAMPIONSHIPBTTS,KXEFLCHAMPIONSHIPTOTAL,KXLALIGAGAME,KXLALIGABTTS,KXLALIGATOTAL,KXLALIGAFTTS,KXEFLCUPGAME,KXEFLCUPBTTS,KXEFLCUPTOTAL,KXEFLCUPFTTS,KXFACUPGAME,KXFACUPBTTS,KXFACUPTOTAL,KXFACUPFTTS,KXINTLFRIENDLYGAME,KXINTLFRIENDLYBTTS,KXINTLFRIENDLYTOTAL,KXBUNDESLIGAGAME,KXBUNDESLIGABTTS,KXBUNDESLIGATOTAL,KXBUNDESLIGAFTTS,KXSERIEAGAME,KXSERIEABTTS,KXSERIEATOTAL,KXSERIEAFTTS

# Market Intelligence history / research
MARKET_INTELLIGENCE_DB_PATH=./data/market_intelligence.sqlite
MARKET_INTELLIGENCE_MINIMUM_SAMPLE_SIZE=8

# Paper scan audit / dashboard read model
PAPER_AUDIT_DB_PATH=./data/paper_audit.sqlite

# Priority Alert in-app notifications (email uses console/test adapter)
NOTIFICATIONS_DB_PATH=./data/notifications.sqlite
NOTIFICATION_COOLDOWN_SECONDS=900

# Historical football facts repository (source of truth; Excel is export-only)
HISTORICAL_DB_PATH=./data/historical_football.sqlite

# Historical odds observations + coverage cache (not a second match-facts store)
HISTORICAL_ODDS_DB_PATH=./data/historical_odds.sqlite

# Browser console origins allowed to call the paper JSON API.
# Comma-separated (not JSON). Settings disables automatic JSON decode for this
# field so this documented EnvSettingsSource value is accepted. Do not set *.
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Paper engine defaults
PAPER_BANKROLL_GBP=5000
PAPER_BANKROLL_USD=5000
PAPER_BANKROLL_KALSHI_USD=5000
# Default off. The Windows paper demo launcher sets this true for that local
# process so qualifying LIVE_PAPER decisions auto-capture via persist_triggered_chain
# (allocator-sized, fail-closed). Labelled /demo fixture replay does not inherit it.
# It is not a live venue order path.
PAPER_AUTOFILL_ENABLED=false
# Paper-only automatic unwind after a second reverse-quote revalidation.
# Default off. Do not enable on the Windows launcher until this Wave-B lane is reviewed.
PAPER_AUTO_UNWIND_ENABLED=false
# Default off. The Windows demo launcher enables the server-owned read-only live-refresh loop
# for that local process only. It does not enable execution.
PAPER_LIVE_REFRESH_ENABLED=false
PAPER_LIVE_REFRESH_INTERVAL_SECONDS=30
# Optional env fallbacks for lane venue participation. Operator UI selections
# persist in PAPER_SETTINGS_DB_PATH and override these. Empty keeps all three on.
# PAPER_HOT_VENUES=matchbook,polymarket,kalshi
# PAPER_UNIVERSE_VENUES=matchbook,polymarket,kalshi
# PAPER_SETTINGS_DB_PATH=./data/paper_settings.sqlite
# HOT cadence alias. Full-sweep generation cadence defaults to 180s with a 150s
# chunked work budget. Do not treat INTERVAL as a blended Fast+Full timestamp.
MIN_NET_EDGE=0.005
MAX_SLIPPAGE_BPS=25
MAX_EVENT_EXPOSURE_GBP=1000
MAX_TOTAL_EXPOSURE_GBP=5000
MAX_EXECUTION_RISK=60
MIN_MAPPING_CONFIDENCE=0.98
SIMULATED_LATENCY_MS=500
SIMULATE_PARTIAL_FILLS=true
FX_SPREAD_BPS=10
# Default off. The Windows demo launcher sets true for that local process only so
# a fresh FX DB bootstraps the latest published ECB USD close and refreshes around
# 16:15 UK on working days. Application default remains false.
ACCOUNTING_SCHEDULE_ENABLED=false
